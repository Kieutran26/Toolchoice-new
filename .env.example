# --- App runtime (Vite, exposed to the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_PASSWORD=

# New-upload proxy (Cloudflare Worker in workers/r2-upload-proxy).
# VITE_R2_UPLOAD_TOKEN is a shared "front door" token, not a secret key -
# it is visible in the client bundle like VITE_ADMIN_PASSWORD already is.
VITE_R2_UPLOAD_PROXY_URL=
VITE_R2_UPLOAD_TOKEN=

# --- Migration scripts only (Node, never shipped to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=toolchoice-assets
R2_PUBLIC_URL=
